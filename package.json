{
  "name": "codex-provider-switcher",
  "displayName": "Secure Codex Provider Switcher (Unofficial)",
  "description": "安全切换 Codex 到自定义 HTTPS Responses API，并在对话框内选择中转模型和推理等级。",
  "version": "2.1.2",
  "publisher": "e50max",
  "author": {
    "name": "E50MAX"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/E50MAX/codex-provider-switcher.git"
  },
  "homepage": "https://github.com/E50MAX/codex-provider-switcher#readme",
  "bugs": {
    "url": "https://github.com/E50MAX/codex-provider-switcher/issues"
  },
  "license": "MIT",
  "pricing": "Free",
  "icon": "Logo.png",
  "preview": true,
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "provider",
    "api",
    "responses api",
    "openai compatible",
    "switcher",
    "security"
  ],
  "main": "./extension.js",
  "extensionKind": [
    "ui"
  ],
  "extensionDependencies": [
    "openai.chatgpt"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:labCodex.switchConnection",
    "onCommand:labCodex.configureLab",
    "onCommand:labCodex.useAccount",
    "onCommand:labCodex.useLab",
    "onCommand:labCodex.repairMaxOption",
    "onCommand:labCodex.deleteLabKey"
  ],
  "contributes": {
    "commands": [
      {
        "command": "labCodex.switchConnection",
        "title": "Codex: 切换账户 / 自定义 API",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "labCodex.configureLab",
        "title": "Codex: 配置自定义 API",
        "icon": "$(settings-gear)"
      },
      {
        "command": "labCodex.useAccount",
        "title": "Codex: 使用 ChatGPT 账户",
        "icon": "$(account)"
      },
      {
        "command": "labCodex.useLab",
        "title": "Codex: 使用自定义 API",
        "icon": "$(server-process)"
      },
      {
        "command": "labCodex.repairMaxOption",
        "title": "Codex: 修复对话框中的 Max 推理等级",
        "icon": "$(tools)"
      },
      {
        "command": "labCodex.deleteLabKey",
        "title": "Codex: 删除本机自定义 API Key",
        "icon": "$(trash)"
      }
    ],
    "configuration": {
      "title": "Secure Codex Provider Switcher",
      "properties": {
        "labCodex.autoReload": {
          "type": "boolean",
          "default": true,
          "description": "切换 provider 后自动重载 VS Code 窗口，使新连接立即生效。"
        },
        "labCodex.autoPatchMax": {
          "type": "boolean",
          "default": true,
          "description": "获得一次明确同意后，在官方 Codex 更新时重新校验并恢复对话框中的 Max 推理等级。"
        },
        "labCodex.autoReloadAfterMaxPatch": {
          "type": "boolean",
          "default": true,
          "description": "成功恢复 Max 推理等级后自动重载一次 VS Code 窗口。"
        }
      }
    }
  },
  "scripts": {
    "lint": "node --check extension.js && node --check lib/validation.js && node --check lib/config-text.js && node --check lib/model-catalog.js && node --check lib/max-patch.js && node --check tools/audit-source.mjs && node --check tools/publish-marketplace.mjs",
    "test": "node --test",
    "audit": "node tools/audit-source.mjs",
    "verify": "npm run lint && npm test && npm run audit",
    "vscode:prepublish": "npm run verify",
    "package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && vsce package --out dist/codex-provider-switcher.vsix",
    "publish:marketplace": "node tools/publish-marketplace.mjs"
  },
  "files": [
    "extension.js",
    "lib/**",
    "scripts/get-secret.ps1",
    "scripts/save-secret.ps1",
    "README.md",
    "SECURITY.md",
    "PRIVACY.md",
    "CHANGELOG.md",
    "LICENSE.txt",
    "Logo.png"
  ],
  "devDependencies": {
    "@azure/identity": "4.13.1",
    "@vscode/vsce": "3.9.2"
  }
}
